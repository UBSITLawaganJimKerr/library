@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<style>
    .books-page {
        background: #f1f1f1;
        min-height: 100vh;
        padding: 40px 20px;
        color: #222;
    }

    .books-container {
        max-width: 1100px;
        margin: auto;
    }

    .books-header {
        background: #111;
        color: white;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .books-header h1 {
        margin: 0;
        font-size: 2rem;
    }

    .books-header p {
        margin: 8px 0 0;
        color: #ccc;
    }

    .add-book {
        display: inline-block;
        background: white;
        color: #111;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        border: 1px solid #ddd;
    }

    .add-book:hover {
        background: #ddd;
        color: #111;
    }

    .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .book-card {
        background: white;
        border: 1px solid #ccc;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }

    .book-number {
        font-size: 0.8rem;
        color: #777;
        margin-bottom: 8px;
    }

    .book-title {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .book-info {
        border-top: 1px solid #ddd;
        padding-top: 12px;
        margin-top: 10px;
    }

    .book-info strong {
        color: #555;
    }

    .category {
        display: inline-block;
        background: #e5e5e5;
        color: #222;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .book-actions {
        margin-top: 20px;
        display: flex;
        gap: 8px;
    }

    .btn-edit {
        background: #777;
        color: white;
        padding: 8px 14px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .btn-delete {
        background: #111;
        color: white;
        padding: 8px 14px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .btn-edit:hover,
    .btn-delete:hover {
        opacity: 0.75;
        color: white;
    }
</style>

<div class="books-page">
    <div class="books-container">

        <div class="books-header">
            <h1>My Library</h1>
            <p>@Model.Count books in the catalogue</p>

            <br>

            <a asp-action="Create" class="add-book">
                + Add a Book
            </a>
        </div>

        <div class="books-grid">

            @foreach (var book in Model)
            {
                <div class="book-card">

                    <div class="book-number">
                        BOOK #@book.BookId
                    </div>

                    <div class="book-title">
                        @book.Title
                    </div>

                    <div class="book-info">
                        <strong>Category</strong>
                        <br>
                        <span class="category">
                            @(book.Category ?? "—")
                        </span>
                    </div>

                    <div class="book-info">
                        <strong>Price</strong>
                        <br>
                        @(book.Price?.ToString("N2") ?? "—")
                    </div>

                    <div class="book-actions">

                        <a asp-action="Edit"
                           asp-route-id="@book.BookId"
                           class="btn-edit">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@book.BookId"
                           class="btn-delete">
                            Delete
                        </a>

                    </div>

                </div>
            }

        </div>

    </div>
</div>